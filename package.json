{
  "name": "fang",
  "productName": "FANG",
  "version": "1.0.0",
  "description": "Phase-by-phase Jira-to-code workbench: plan with jira-to-code, implement with Raphael. Never commits or pushes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "dev.fang.app",
    "productName": "FANG",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "companion/**",
      "renderer/**",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FANG uses the microphone for voice commands and dictation."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
